import { BANQUE, MANIFESTE, question, branche, branches } from '../../src/lib/discovery/open-v3/banque.ts';
let e = 0;
const ex = (c: boolean, q: string) => { console.log((c ? '  ✓ ' : '  ✗ ÉCHEC — ') + q); if (!c) e++; };
console.log('\nBanque Discovery OPEN V3 — chargement et validation');
ex(BANQUE.length === MANIFESTE.questions_actives, `la banque porte ${BANQUE.length} questions, le manifeste en annonce ${MANIFESTE.questions_actives}`);
ex(BANQUE.every(q => q.condition_emission.length > 0), 'aucune question sans condition d\'ouverture');
ex(new Set(BANQUE.map(q => q.id)).size === BANQUE.length, 'aucun identifiant en double');
ex(BANQUE.filter(q => q.forme !== 'open').every(q => q.options.length > 0), 'aucune question fermée sans option');
ex(BANQUE.flatMap(q => q.options).filter(o => o.voie === 'HSG_EVIDENCE').every(o => !!o.famille), 'toute preuve HSG sait dans quelle famille écrire');
ex(question('inexistant-xyz') === undefined, 'un identifiant inconnu rend undefined, jamais une question approchante');
ex(branche('branche-inexistante').length === 0, 'une branche inconnue rend zéro question');
const opts = BANQUE.flatMap(q => q.options);
console.log(`\n  ${BANQUE.length} questions · ${opts.length} options · ${branches().length} branches`);
const parVoie = new Map<string, number>();
for (const o of opts) parVoie.set(o.voie, (parVoie.get(o.voie) ?? 0) + 1);
console.log('  voies :', [...parVoie.entries()].sort((a,b)=>b[1]-a[1]).map(([k,v])=>`${k}=${v}`).join(' · '));
const ouvertes = BANQUE.filter(q => q.forme === 'open');
ex(ouvertes.every(q => !!q.inferences_interdites), `les ${ouvertes.length} questions ouvertes portent toutes leurs inférences interdites`);
console.log(e === 0 ? '\nOK — 0 échec.' : `\n${e} ÉCHEC(S).`);
process.exit(e === 0 ? 0 : 1);
